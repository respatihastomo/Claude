# ---- svc-pemantauan (scripts/jalankan-svc.sh svc-pemantauan) ----
PORT=3110
DATABASE_URL=postgres://api_pemantauan_login:api_dev@localhost:5432/db_pemantauan
DATABASE_WORKER_URL=postgres://worker_pemantauan_login:worker_dev@localhost:5432/db_pemantauan
BROKER=http
# HppDihitung belum punya pelanggan; audit -> svc-audit
BROKER_HTTP_TARGETS='arkas.audit.dicatat=http://localhost:3108/internal/v1/events'
JWT_PUBLIC_KEY_FILE=../../.dev-keys/public.pem
JWT_ISSUER=arkas-identitas
JWT_AUDIENCE=arkas-api
INTERNAL_EVENTS_TOKEN=dev-internal-token-ganti-saya
HPP_INTERVAL_MS=1000
OTEL_SERVICE_NAME=svc-pemantauan
