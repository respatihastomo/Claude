# ---- svc-audit (scripts/jalankan-svc.sh svc-audit) ----
PORT=3108
DATABASE_URL=postgres://api_audit_login:api_dev@localhost:5432/db_audit
DATABASE_WORKER_URL=postgres://worker_audit_login:worker_dev@localhost:5432/db_audit
# Menerima AuditDicatat dari semua layanan lewat /internal/v1/events (BROKER=http); tidak menerbitkan event.
BROKER=http
BROKER_HTTP_TARGETS=
JWT_PUBLIC_KEY_FILE=../../.dev-keys/public.pem
JWT_ISSUER=arkas-identitas
JWT_AUDIENCE=arkas-api
INTERNAL_EVENTS_TOKEN=dev-internal-token-ganti-saya
OTEL_SERVICE_NAME=svc-audit
