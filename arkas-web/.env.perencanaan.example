# ---- svc-perencanaan (scripts/jalankan-svc.sh svc-perencanaan) ----
PORT=3107
DATABASE_URL=postgres://api_perencanaan_login:api_dev@localhost:5432/db_perencanaan
DATABASE_WORKER_URL=postgres://worker_perencanaan_login:worker_dev@localhost:5432/db_perencanaan
BROKER=http
# KertasKerjaDisahkan -> svc-penatausahaan (proyeksi RKAS & buka periode). KertasKerjaDiajukan belum punya pelanggan (svc-integrasi).
BROKER_HTTP_TARGETS='arkas.perencanaan.kk-disahkan=http://localhost:3105/internal/v1/events,http://localhost:3109/internal/v1/events;arkas.audit.dicatat=http://localhost:3108/internal/v1/events'
JWT_PUBLIC_KEY_FILE=../../.dev-keys/public.pem
JWT_ISSUER=arkas-identitas
JWT_AUDIENCE=arkas-api
INTERNAL_EVENTS_TOKEN=dev-internal-token-ganti-saya
OTEL_SERVICE_NAME=svc-perencanaan
