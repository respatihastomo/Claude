# ---- svc-identitas (scripts/jalankan-svc.sh svc-identitas) ----
PORT=3104
DATABASE_URL=postgres://api_auth_login:api_dev@localhost:5432/db_auth
DATABASE_WORKER_URL=postgres://worker_auth_login:worker_dev@localhost:5432/db_auth
BROKER=http
# PenggunaDibuat/PeranDiubah belum punya pelanggan (svc-audit belum dirilis)
BROKER_HTTP_TARGETS='arkas.audit.dicatat=http://localhost:3108/internal/v1/events'
INTERNAL_EVENTS_TOKEN=dev-internal-token-ganti-saya
# 16.1: kunci privat HANYA di svc-identitas. Layanan lain memverifikasi dengan pasangan publiknya (atau JWKS /.well-known/jwks.json).
JWT_PRIVATE_KEY_FILE=../../.dev-keys/private.pem
JWT_ISSUER=arkas-identitas
JWT_AUDIENCE=arkas-api
TOKEN_TTL_DETIK=900
SESI_TTL_JAM=8
SESI_IDLE_MENIT=60
# dev lewat http://localhost: false. Produksi (HTTPS): true
COOKIE_SECURE=false
OIDC_STATE_SECRET=ganti-dengan-rahasia-acak-minimal-32-karakter
# SSO (OpenID Connect) — isi ketiganya untuk mengaktifkan "Masuk dengan SSO"
# OIDC_ISSUER=https://sso.contoh.example
# OIDC_CLIENT_ID=arkas-web
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URI=http://localhost:3000/api/v1/auth/callback
# HANYA dev: masuk sebagai pengguna contoh tanpa SSO
AUTH_DEV_ENABLED=true
OTEL_SERVICE_NAME=svc-identitas
