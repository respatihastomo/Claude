# ---- svc-pelaporan (scripts/jalankan-svc.sh svc-pelaporan) ----
PORT=3106
DATABASE_URL=postgres://api_pelaporan_login:api_dev@localhost:5432/db_pelaporan
DATABASE_WORKER_URL=postgres://worker_pelaporan_login:worker_dev@localhost:5432/db_pelaporan
BROKER=http
# LaporanDitandatangani belum punya pelanggan (svc-integrasi & svc-pemantauan belum dirilis)
BROKER_HTTP_TARGETS='arkas.audit.dicatat=http://localhost:3108/internal/v1/events'
JWT_PUBLIC_KEY_FILE=../../.dev-keys/public.pem
JWT_ISSUER=arkas-identitas
JWT_AUDIENCE=arkas-api
INTERNAL_EVENTS_TOKEN=dev-internal-token-ganti-saya
# chromium = Playwright lokal (dev); gotenberg = GOTENBERG_URL (produksi)
PDF=chromium
PENYIMPANAN_DIR=../../.berkas
# simulasi = TTE simulasi dev (BUKAN TTE sah); bsre = belum tersedia
TTE=simulasi
OTEL_SERVICE_NAME=svc-pelaporan
