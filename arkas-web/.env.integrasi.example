# ---- svc-integrasi (scripts/jalankan-svc.sh svc-integrasi) ----
PORT=3109
DATABASE_URL=postgres://api_integrasi_login:api_dev@localhost:5432/db_integrasi
DATABASE_WORKER_URL=postgres://worker_integrasi_login:worker_dev@localhost:5432/db_integrasi
BROKER=http
# TransaksiMitra* -> penatausahaan; PembukaanDikonfirmasi & TransaksiMitra* -> pemantauan (bila dijalankan); audit -> svc-audit
BROKER_HTTP_TARGETS='arkas.integrasi.pembukaan-dikonfirmasi=http://localhost:3110/internal/v1/events;arkas.integrasi.transaksi-mitra-diterima=http://localhost:3105/internal/v1/events,http://localhost:3110/internal/v1/events;arkas.integrasi.transaksi-mitra-dibatalkan=http://localhost:3105/internal/v1/events,http://localhost:3110/internal/v1/events;arkas.audit.dicatat=http://localhost:3108/internal/v1/events'
JWT_PUBLIC_KEY_FILE=../../.dev-keys/public.pem
JWT_ISSUER=arkas-identitas
JWT_AUDIENCE=arkas-api
INTERNAL_EVENTS_TOKEN=dev-internal-token-ganti-saya
# HANYA dev: ganti di produksi (>= 32 karakter, dari secret manager)
MITRA_TOKEN_SECRET=dev-kunci-token-mitra-ganti-saya-0123456789
# jumlah proxy tepercaya (API Gateway) di depan layanan; 0 di dev (Mitra memanggil langsung)
TRUST_PROXY=0
OTEL_SERVICE_NAME=svc-integrasi
