# ---- svc-bantuan (scripts/jalankan-svc.sh svc-bantuan) ----
PORT=3111
DATABASE_URL=postgres://api_banper_login:api_dev@localhost:5432/db_banper
DATABASE_WORKER_URL=postgres://worker_banper_login:worker_dev@localhost:5432/db_banper
BROKER=http
# SumberDanaDisahkan -> referensi, perencanaan, integrasi; PenyaluranDicatat -> penatausahaan; audit -> svc-audit
BROKER_HTTP_TARGETS='arkas.banper.sumber-dana-disahkan=http://localhost:3103/internal/v1/events,http://localhost:3107/internal/v1/events,http://localhost:3109/internal/v1/events;arkas.banper.penyaluran-dicatat=http://localhost:3105/internal/v1/events;arkas.audit.dicatat=http://localhost:3108/internal/v1/events'
JWT_PUBLIC_KEY_FILE=../../.dev-keys/public.pem
JWT_ISSUER=arkas-identitas
JWT_AUDIENCE=arkas-api
INTERNAL_EVENTS_TOKEN=dev-internal-token-ganti-saya
# dev: folder lokal (produksi: S3 bucket dokumen, versioning + pemindaian malware)
PENYIMPANAN_DIR=../../.berkas-bantuan
IMPOR_INTERVAL_MS=1000
OTEL_SERVICE_NAME=svc-bantuan
