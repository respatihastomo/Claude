# ---- svc-penatausahaan ----
PORT=3105
DATABASE_URL=postgres://api_tatausaha_login:api_dev@localhost:5432/db_tatausaha
DATABASE_WORKER_URL=postgres://worker_tatausaha_login:worker_dev@localhost:5432/db_tatausaha
# memory = broker dalam-proses (dev); kafka = Kafka/Redpanda (BROKER_BROKERS)
BROKER=memory
BROKER_BROKERS=localhost:19092
JWT_PUBLIC_KEY_FILE=../../.dev-keys/public.pem
JWT_ISSUER=arkas-identitas
JWT_AUDIENCE=arkas-api
# HANYA dev: endpoint /internal/v1/events untuk menyuntikkan event layanan hulu yang belum dirilis
DEV_EVENTS_ENABLED=true
INTERNAL_EVENTS_TOKEN=dev-internal-token-ganti-saya
# HANYA dev/demo: izinkan penutupan buku sebelum akhir bulan (produksi: false)
TUTUP_SEBELUM_AKHIR_BULAN=true
OTEL_SERVICE_NAME=svc-penatausahaan

# ---- migrasi (scripts/migrate.mjs) ----
DATABASE_ADMIN_URL=postgres://postgres:postgres@localhost:5432/postgres
API_DB_PASSWORD=api_dev
WORKER_DB_PASSWORD=worker_dev
