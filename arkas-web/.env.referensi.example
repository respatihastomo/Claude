# ---- svc-referensi (scripts/jalankan-svc.sh svc-referensi) ----
PORT=3103
DATABASE_URL=postgres://api_ref_login:api_dev@localhost:5432/db_ref
DATABASE_WORKER_URL=postgres://worker_ref_login:worker_dev@localhost:5432/db_ref
BROKER=http
# ReferensiDiubah -> svc-identitas, svc-penatausahaan, svc-perencanaan (proyeksi lokal)
BROKER_HTTP_TARGETS='arkas.ref.referensi-diubah=http://localhost:3104/internal/v1/events,http://localhost:3105/internal/v1/events,http://localhost:3107/internal/v1/events,http://localhost:3109/internal/v1/events,http://localhost:3110/internal/v1/events;arkas.audit.dicatat=http://localhost:3108/internal/v1/events'
JWT_PUBLIC_KEY_FILE=../../.dev-keys/public.pem
JWT_ISSUER=arkas-identitas
JWT_AUDIENCE=arkas-api
INTERNAL_EVENTS_TOKEN=dev-internal-token-ganti-saya
OTEL_SERVICE_NAME=svc-referensi
